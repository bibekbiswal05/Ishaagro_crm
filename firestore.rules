rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isActiveUser() {
      return signedIn() && currentUserDoc().data.active == true;
    }

    function isAdmin() {
      return isActiveUser() && currentUserDoc().data.role == "admin";
    }

    function isTechnician() {
      return isActiveUser() && currentUserDoc().data.role == "technician";
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /farmers/{farmerId} {
      allow read: if isAdmin() || (isTechnician() && resource.data.technicianId == request.auth.uid);
      allow create: if isAdmin() || (isTechnician() && request.resource.data.technicianId == request.auth.uid);
      allow update: if isAdmin() || (
        isTechnician()
        && resource.data.technicianId == request.auth.uid
        && request.resource.data.technicianId == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    match /farmerQueries/{queryId} {
      allow read: if isAdmin() || (isTechnician() && resource.data.technicianId == request.auth.uid);
      allow create: if isTechnician() && request.resource.data.technicianId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /reminders/{reminderId} {
      allow read: if isAdmin() || (isTechnician() && resource.data.assignedTo == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }
  }
}
